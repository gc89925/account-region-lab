# Copy to /etc/account-region-lab.env, owned by root:regionlab, mode 0640.
# Use the exact external HTTPS origin, with no path or trailing slash.
REGION_LAB_PUBLIC_ORIGIN=https://lab.example.com
BROWSER_PATH=/usr/bin/google-chrome
REGION_LAB_MAX_ENVIRONMENTS=5
# Optional for small servers. Install the Chrome policy separately as documented.
# REGION_LAB_RESOURCE_MODE=lean
# REGION_LAB_DESKTOP_GEOMETRY=1024x768
# REGION_LAB_X11VNC_DAMAGE=1
# Do not put PORT here: the controller uses 4317 and the gateway uses 4318.
# Proxy passwords and gateway access credentials do not belong in this file.
