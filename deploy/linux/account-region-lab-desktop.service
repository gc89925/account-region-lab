[Unit]
Description=Account Region Lab private browser desktop
After=network.target
Wants=account-region-lab.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
User=regionlab
Group=regionlab
WorkingDirectory=/var/lib/account-region-lab
Environment=HOME=/var/lib/account-region-lab
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/account-region-lab/Xauthority
RuntimeDirectory=account-region-lab
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/bash /opt/account-region-lab/app/deploy/linux/start-desktop.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=15
KillMode=control-group
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
