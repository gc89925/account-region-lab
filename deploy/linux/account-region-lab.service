[Unit]
Description=Account Region Lab server browser controller
After=network-online.target account-region-lab-desktop.service
Requires=account-region-lab-desktop.service
Wants=network-online.target account-region-lab-gateway.service
PartOf=account-region-lab-desktop.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=regionlab
Group=regionlab
WorkingDirectory=/opt/account-region-lab/app
EnvironmentFile=/etc/account-region-lab.env
Environment=HOME=/var/lib/account-region-lab
Environment=PATH=/opt/account-region-lab/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=REGION_LAB_REMOTE=1
Environment=REGION_LAB_DATA_DIR=/var/lib/account-region-lab/data
Environment=PORT=4317
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/account-region-lab/Xauthority
Environment=XDG_RUNTIME_DIR=/run/account-region-lab
UMask=0077
ExecStart=/opt/account-region-lab/node/bin/node /opt/account-region-lab/app/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
